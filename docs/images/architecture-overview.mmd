flowchart TB
  subgraph OCP["OpenShift cluster — hard platform constraint"]
    direction TB

    API["FastAPI — POST /query · /admin/*"]
    REACT["ReAct agent loop — lib/reasoning/pipeline.py<br/>LLM chooses tools · max 6 rounds · tool_call_trace"]

    API --> REACT

    subgraph TOOLS["Agent tools — called in any order"]
      direction LR
      T1["get_affected_subgraph<br/><b>NO LLM</b> · Neo4j Cypher"]
      T2["solve_impact<br/><b>NO LLM</b> · PostGIS + Solver"]
      T3["search_scenario_context<br/><b>via LLM client</b> · pgvector"]
      T4["run_ingestion_pull<br/>on-demand adapter"]
    end

    REACT --> TOOLS

    LLM["LLM client — OpenAI-compatible<br/>inference + embed · pgvector via asyncpg"]
    LS["Llama Stack — inference gateway<br/>maas · openai · local vLLM"]
    VLLM["vLLM optional — llm-service<br/>OpenShift AI / KServe"]

    T3 --> LLM
    REACT --> LLM
    LLM --> LS
    LS -.-> VLLM

    subgraph DIRECT["Queried directly — not via Llama Stack"]
      direction LR
      NJ["Neo4j — dependency graph<br/>+ SimulationEvent overlays"]
      PG["PostgreSQL StatefulSet<br/>pgvector + PostGIS<br/>no AGE"]
    end

    T1 --> NJ
    T2 --> PG
    LLM --> PG
    T4 --> PG
  end

