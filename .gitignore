# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets / overrides
.env
helm/values-secrets.yaml

# Packaged chart artifacts (make package-chart); CI publishes to GitHub Pages
dist/

# Vendored umbrella subchart archives (regenerated by helm dependency update)
helm/charts/
helm/tmpcharts-*/

# Frontend (frontend_ui / Simulation Console)
node_modules/
frontend_ui/dist/
src/api/static/console/*
!src/api/static/console/.gitkeep
apps/**/dist/
