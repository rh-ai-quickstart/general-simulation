# Copy to values-secrets.yaml (gitignored) and fill in before deploy.
#   cp helm/values-secrets.yaml.example helm/values-secrets.yaml
#
# Or pass the same keys via make deploy / helm --set.
# Required tokens depend on global.models.<key>.enabled in values.yaml.

global:
  postgres:
    password: "CHANGE_ME"
  neo4j:
    password: "CHANGE_ME"
  models:
    external-model:
      apiToken: "CHANGE_ME"   # when external-model.enabled
    nomic:
      apiToken: "CHANGE_ME"   # when nomic.enabled (remote MaaS embeddings; default is inline)
    openai:
      apiToken: "CHANGE_ME"   # when openai.enabled

llm-service:
  secret:
    hf_token: "CHANGE_ME"     # when llm-service.enabled
