# Copy to values-secrets.yaml (gitignored) and fill in before deploy.
#   cp helm/values-secrets.yaml.example helm/values-secrets.yaml
#
# Or pass the same keys via make deploy / helm --set.

global:
  postgres:
    password: "CHANGE_ME"
  neo4j:
    password: "CHANGE_ME"
  models:
    external-model:
      apiToken: "CHANGE_ME"   # maas mode (default)
    openai:
      apiToken: "CHANGE_ME"   # openai mode only

llm-service:
  secret:
    hf_token: "CHANGE_ME"     # local mode only
