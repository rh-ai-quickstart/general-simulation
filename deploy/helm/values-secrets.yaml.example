# Copy to values-secrets.yaml (gitignored) and fill in before deploy.
#   cp deploy/helm/values-secrets.yaml.example deploy/helm/values-secrets.yaml
#
# Required keys depend on global.models.<key>.enabled and llm-service.enabled
# in deploy/helm/values.yaml. Helm fails at template time if a required secret is missing.

global:
  postgres:
    password: "CHANGE_ME"
  neo4j:
    password: "CHANGE_ME"
  models:
    external-model:
      apiToken: "CHANGE_ME"   # when external-model.enabled
    nomic:
      apiToken: "CHANGE_ME"   # when nomic.enabled (remote MaaS embeddings; default is inline)
    openai:
      apiToken: "CHANGE_ME"   # when openai.enabled

llm-service:
  secret:
    hf_token: "CHANGE_ME"     # when llm-service.enabled
